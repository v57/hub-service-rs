#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

cd "$(dirname "$0")/.."

# Next to a Channel checkout, test against it instead of the channel-rs revision Cargo.toml names. The patch
# rewrites Cargo.lock's channel-rs entries, so the committed lock (the git revision) is put back afterwards.
channel=../../Channel/channel-rs/crates/channel-rs
if [[ -d "$channel" ]]; then
  lock="$(mktemp)"
  cp Cargo.lock "$lock"
  trap 'mv "$lock" Cargo.lock' EXIT
  cargo test --config "patch.\"https://github.com/v57/channel-rs\".channel-rs.path=\"$channel\""
else
  cargo test
fi
